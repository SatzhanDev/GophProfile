APP_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=10s

DB_HOST=localhost
DB_PORT=5434
DB_USER=gophprofile
# DB_PASSWORD обязателен — без дефолта в коде (см. README/Безопасность),
# приложение не запустится, если её не задать явно.
DB_PASSWORD=gophprofile
DB_NAME=gophprofile
DB_SSLMODE=disable

S3_ENDPOINT=localhost:9000
# S3_ACCESS_KEY и S3_SECRET_KEY тоже обязательны, без дефолта в коде.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false

# RABBITMQ_URL обязателен, без дефолта в коде.
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

# Через запятую; "*" — разрешить всем (нормально для разработки, не для прода).
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

MIGRATIONS_PATH=migrations
